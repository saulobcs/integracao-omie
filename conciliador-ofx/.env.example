# Credenciais da API Omie (NAO versione o .env real -- ja esta no .gitignore).
# Copie este arquivo para .env e preencha com suas chaves.
#
#   cp .env.example .env
#
# As credenciais sao obtidas no proprio Omie ao cadastrar um aplicativo/integracao.

OMIE_APP_KEY=
OMIE_APP_SECRET=

# Host base da API (normalmente nao precisa mudar).
OMIE_BASE=https://app.omie.com.br/api/v1
